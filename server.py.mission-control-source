function scoreEvent(e){
  const status=String(e.status||'').toLowerCase();
  const action=String(e.action||'').toLowerCase();
  const kind=String(e.kind||'').toLowerCase();
  if(status==='done') return 10;
  if(status==='blocked'||status==='error'||status==='stalled') return -8;
  if(status==='running') return 2;
  if(status==='selected'||status==='queued'||status==='saved') return 1;
  if(action==='write_file'||action==='create_tool') return 4;
  if(action==='run_shell') return 2;
  if(action==='web_search') return 1;
  if(kind==='learning') return 3;
  return 0;
}
function drawProductivityChart(points){
  const canvas=document.getElementById('productivityChart'); if(!canvas)return;
  const dpr=window.devicePixelRatio||1; const rect=canvas.getBoundingClientRect();
  const w=Math.max(260, Math.floor(rect.width*dpr)); const h=Math.max(110, Math.floor(rect.height*dpr));
  if(canvas.width!==w||canvas.height!==h){canvas.width=w;canvas.height=h;}
  const ctx=canvas.getContext('2d'); ctx.clearRect(0,0,w,h);
  ctx.fillStyle='#07101d'; ctx.fillRect(0,0,w,h);
  ctx.strokeStyle='#23304a'; ctx.lineWidth=1*dpr;
  for(let i=1;i<4;i++){const y=Math.round(h*i/4); ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(w,y); ctx.stroke();}
  if(!points.length){return;}
  const min=Math.min(...points,0); const max=Math.max(...points,10); const span=Math.max(1,max-min);
  const xFor=i=>points.length===1?w-10*dpr:(10*dpr)+(i*(w-20*dpr)/(points.length-1));
  const yFor=v=>(h-12*dpr)-((v-min)*(h-24*dpr)/span);
  ctx.strokeStyle='#4da3ff'; ctx.lineWidth=2.5*dpr; ctx.beginPath();
  points.forEach((p,i)=>{const x=xFor(i), y=yFor(p); if(i===0)ctx.moveTo(x,y); else ctx.lineTo(x,y);});
  ctx.stroke();
  const last=points[points.length-1]; const first=points[0];
  ctx.fillStyle=last>=first?'#37d27a':'#ff6b6b';
  ctx.beginPath(); ctx.arc(xFor(points.length-1), yFor(last), 4*dpr, 0, Math.PI*2); ctx.fill();
}
function renderProductivityOverview(s){
  const tasks=(s.autonomy&&s.autonomy.tasks)||[];
  const journal=(s.autonomy&&s.autonomy.journal)||[];
  const code=s.code_activity||[];
  const learnings=(s.memory&&s.memory.learnings)||[];
  const done=tasks.filter(t=>t.status==='done').length;
  const blocked=tasks.filter(t=>['blocked','error','stalled'].includes(t.status)).length + journal.filter(j=>['blocked','error','stalled'].includes(j.status)).length;
  const codeCount=code.filter(c=>['write_file','create_tool','run_shell'].includes(c.action)).length;
  const learned=learnings.length;
  const setText=(id,v)=>{const el=document.getElementById(id); if(el)el.textContent=String(v);}
  setText('kpiDone',done); setText('kpiCode',codeCount); setText('kpiLearned',learned); setText('kpiBlocked',blocked);
  const events=[
    ...journal.map(e=>Object.assign({src:'journal'},e)),
    ...code.slice(-40).map(e=>Object.assign({src:'code'},e)),
    ...learnings.slice(-12).map(e=>({src:'learning',kind:'learning',status:'learned',text:e.text,ts:e.ts}))
  ].slice(-50);
  let total=0; const points=[];
  events.forEach(e=>{total+=scoreEvent(e); points.push(total);});
  if(!points.length) points.push(0);
  drawProductivityChart(points);
  const delta=points[points.length-1]-points[0];
  const trendClass=delta>3?'trend-up':(delta<-3?'trend-down':'trend-flat');
  const caption=document.getElementById('chartCaption');
  if(caption){caption.innerHTML=`Trend <span class="${trendClass}">${delta>=0?'+':''}${delta}</span> - Produktivitaet ${esc(String(s.productivity_percent||100))}%`;}
  const recentLearn=learnings.slice(-2).reverse().map(l=>`<div class="learning-line">Gelernt: ${esc(l.text||'')}</div>`).join('');
  const recentBad=journal.slice().reverse().filter(j=>['blocked','error','stalled'].includes(j.status)).slice(0,2).map(j=>`<div class="learning-line"><span class="trend-down">Achtung:</span> ${esc(j.text||j.goal||'Blockade')}</div>`).join('');
  const active=(s.current_goal||'').trim();
  const notes=document.getElementById('overviewNotes');
  if(notes){
    notes.innerHTML=
      `<div class="learning-line"><span class="${trendClass}">${delta>3?'laeuft besser':delta<-3?'braucht Aufmerksamkeit':'stabil'}</span>${active?' - '+esc(active):''}</div>`+
      (recentBad||'')+
      (recentLearn||'<div class="learning-line muted">Noch keine neuen Learnings im Verlauf.</div>');
  }
}

