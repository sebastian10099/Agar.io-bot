def _cached_snapshot(name, ttl_seconds, maker):
    now = time.time()
    hit = _STATUS_CACHE.get(name)
    if hit and now - hit.get("ts", 0) < ttl_seconds:
        return hit.get("value")
    value = maker()
    _STATUS_CACHE[name] = {"ts": now, "value": value}
    return value


def _run_text(cmd, cwd=None, timeout=5):
    try:
        env = os.environ.copy()
        env.setdefault("HOME", "/root")
        p = subprocess.run(
            cmd,
            cwd=cwd,
            env=env,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
            check=False,
        )
        return p.stdout.strip()
    except Exception as e:
        return str(e)


def _hybrid_status_snapshot(main_state, support_state=None, hermes_state=None):
    support_state = support_state or {}
    hermes_state = hermes_state or {}
    provider = str(CONFIG.get("provider", "ollama"))
