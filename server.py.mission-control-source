def _validate_changed_path(path):
    path = str(path or "").strip()
    if not path:
        return {"ok": False, "path": path, "message": "kein Pfad"}
    try:
        if not os.path.isabs(path):
            path = os.path.join(HERE, "agent_workspace", path)
        path = os.path.abspath(path)
        if not os.path.exists(path):
            return {"ok": True, "path": path, "message": "alter Historienpfad fehlt; ignoriert"}
        if os.path.isdir(path):
            return {"ok": True, "path": path, "message": "Ordner vorhanden"}
        if path.endswith(".py"):
            import py_compile
            py_compile.compile(path, doraise=True)
            return {"ok": True, "path": path, "message": "Python-Syntax OK"}
        if path.endswith(".sh"):
            r = subprocess.run(["bash", "-n", path], capture_output=True, text=True, timeout=10)
            if r.returncode == 0:
                return {"ok": True, "path": path, "message": "Shell-Syntax OK"}
            return {"ok": False, "path": path, "message": (r.stderr or r.stdout or "bash -n fehlgeschlagen")[:180]}
        if path.endswith(".json"):
            with open(path, encoding="utf-8") as f:
                json.load(f)
            return {"ok": True, "path": path, "message": "JSON OK"}
        if os.path.getsize(path) > 0:
            return {"ok": True, "path": path, "message": "Datei vorhanden/nicht leer"}
        if path.endswith((".md", ".txt", ".log")):
            return {"ok": True, "path": path, "message": "leere Notizdatei; kein Syntaxfehler"}
        return {"ok": False, "path": path, "message": "Datei ist leer"}
    except Exception as e:
        return {"ok": False, "path": path, "message": str(e)[:180]}


def _auto_validate_pending_paths(paths):
    uniq = []
    for p in paths:
        if p and p not in uniq:
            uniq.append(p)
    results = [_validate_changed_path(p) for p in uniq[-12:]]
    ok = all(r.get("ok") for r in results) if results else True
    return {"ok": ok, "results": results}


def _agent_test_gate(agent_state, label):
    events = agent_state.get("code_activity") or []
    journals = agent_state.get("autonomy", {}).get("journal", [])
    last_test = -1
    writes_after_test = []
    failed_checks = []
    tests = 0
    for i, e in enumerate(events):
        action = e.get("action")
        gate = _test_gate_event_result(e)
        if gate == "failed":
            failed_checks.append(e.get("path") or e.get("title") or "Aenderung")
        if action == "run_shell" or gate == "passed":
            last_test = i
            tests += 1
        if action in {"write_file", "create_tool"} and i > last_test and gate != "passed":
            writes_after_test.append(e.get("path") or e.get("title") or "Aenderung")
    blocked = [
        j for j in journals[-20:]
        if j.get("status") in {"error", "stalled"}
        or (j.get("status") == "blocked" and "Maximale Schrittzahl" not in str(j.get("text") or ""))
    ]
    auto_validation = _auto_validate_pending_paths(writes_after_test) if writes_after_test else {"ok": True, "results": []}
    if failed_checks:
        status = "blocked"
        message = f"{len(failed_checks)} Test-Gate-Fehler offen"
    elif blocked:
        status = "blocked"
        message = blocked[-1].get("text") or "Blockade vorhanden"
    elif writes_after_test and not auto_validation.get("ok"):
        failed = [r for r in auto_validation.get("results", []) if not r.get("ok")]
        status = "needs_test"
        message = f"{len(failed) or len(writes_after_test)} Aenderung(en) brauchen Korrektur/Test"
    elif writes_after_test:
        status = "passed"
        message = f"{len(writes_after_test)} Aenderung(en) automatisch geprueft"
        tests += len(writes_after_test)
        last_test = max(last_test, len(events) - 1)
        writes_after_test = []
    elif tests:
        status = "passed"
        message = "Letzte Aenderungen haben Test/Ausfuehrung"
    else:
        status = "waiting"
        message = "Noch keine Testdaten"
    return {
        "agent": label,
        "status": status,
        "message": message,
        "tests": tests,
        "untested": writes_after_test[-6:],
        "auto_validation": auto_validation,
        "last_test_at": events[last_test].get("ts") if last_test >= 0 else "",
    }


def _test_gate_snapshot(main_state, support_state, hermes_state=None):
    support_state = support_state or {}
    hermes_state = hermes_state or {}
    gates = [_agent_test_gate(main_state, "Haupt")]
    if support_state:
        gates.append(_agent_test_gate(support_state, "Support"))
    if hermes_state:
        gates.append(_agent_test_gate(hermes_state, "Hermes"))
    overall = "passed"
    if any(g["status"] == "blocked" for g in gates):
        overall = "blocked"
    elif any(g["status"] == "needs_test" for g in gates):
        overall = "needs_test"
    elif any(g["status"] == "waiting" for g in gates):
        overall = "waiting"
    return {"overall": overall, "agents": gates}


def _team_coordinator_snapshot(main_state, support_state, hermes_state=None):
    support_state = support_state or {}
    hermes_state = hermes_state or {}
    main_busy = main_state.get("status") in {"running", "planning", "waiting_confirm"}
    support_busy = support_state.get("status") in {"running", "planning", "waiting_confirm"}
    hermes_busy = hermes_state.get("status") in {"running", "planning", "waiting_confirm"}
    main_goal = main_state.get("current_goal") or ""
    support_goal = support_state.get("current_goal") or ""
    hermes_goal = hermes_state.get("current_goal") or ""
    journals = (main_state.get("autonomy", {}).get("journal", []) +
                support_state.get("autonomy", {}).get("journal", []) +
                hermes_state.get("autonomy", {}).get("journal", []))
    recent_bad = [j for j in journals if j.get("status") in {"blocked", "error", "stalled"}]
    if main_busy and not support_busy and not hermes_busy:
        owner = "Support"
        step = "Support-Agent fuer Review, Risikoanalyse oder Testvorschlag auf das aktuelle Haupt-Ziel ansetzen."
    elif main_busy and support_busy and not hermes_busy:
        owner = "Hermes"
        step = "Hermes soll Roadmap, Wiederholungen und Team-Journal pruefen, waehrend Haupt/Support arbeiten."
    elif support_busy and not main_busy and not hermes_busy:
        owner = "Haupt"
        step = "Haupt-Agent kann die Support-Erkenntnisse aufnehmen oder die naechste Umsetzung starten."
    elif hermes_busy and not main_busy:
        owner = "Haupt"
        step = "Haupt-Agent kann Hermes-Plan aufnehmen oder die naechste konkrete Umsetzung starten."
    elif main_busy and support_busy and hermes_busy:
        owner = "Team"
        step = "Alle drei arbeiten parallel; Team-Journal beobachten und doppelte Datei-Arbeit vermeiden."
    else:
        owner = "Team"
        step = "Neue Aufgabe mit passender Zuteilung starten: Team, Haupt, Support, Review, Recherche oder Hermes Meta."
    risk = recent_bad[-1].get("text") if recent_bad else ""
    return {
        "mode": "Haupt + Support + Hermes",
        "next_owner": owner,
        "next_step": step,
        "risk": risk or "keine akute Warnung",
        "rule": "Haupt baut; Support prueft/testet; Hermes pflegt Roadmap, Anti-Wiederholung und Lernnotizen.",
        "main_goal": main_goal,
        "support_goal": support_goal,
        "hermes_goal": hermes_goal,
    }


