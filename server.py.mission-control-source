<script>
function esc(s){return(s||'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}
const AGENT_AUTH_HEADER='Basic c2ViaWU6YWdlbnQtZWtCVmVlMTIzaXpkVW9McktN';
function agentFetch(url, opts){opts=opts||{};opts.headers=Object.assign({}, opts.headers||{}, {'Authorization': AGENT_AUTH_HEADER});opts.credentials='include';const cleanOrigin=window.location.protocol+'//'+window.location.host;const target=(typeof url==='string'&&url.startsWith('/'))?cleanOrigin+url:url;return fetch(target, opts)}

let explorerPath='.';
let explorerScope='main';
let selectedFilePath='';
let lastExplorerFetch=0;
let lastCodeActivitySig='';
function fmtSize(n){n=Number(n||0); if(n<1024)return n+' B'; if(n<1048576)return (n/1024).toFixed(1)+' KB'; return (n/1048576).toFixed(1)+' MB'}
function codedPathSet(codeActivity){
  const set=new Set();
  (codeActivity||[]).forEach(c=>{ if(c.path) set.add(String(c.path).replace(/^\/+/,'')); });
  return set;
}
function renderExplorer(data, codeActivity){
  const list=document.getElementById('fileList'); const cwd=document.getElementById('fileCwd'); if(!list||!data)return;
  cwd.textContent=data.cwd||'.'; explorerPath=data.cwd||'.';
  const coded=codedPathSet(codeActivity);
  const rows=[];
  if(data.parent!==null && data.parent!==undefined){rows.push(`<div class="file-row" onclick="openExplorerPath('${esc(data.parent)}')"><span>?</span><span class="file-name">..</span><span></span></div>`)}
  (data.entries||[]).forEach(e=>{
    const icon=e.type==='dir'?'??':'??';
    const cls=(e.path===selectedFilePath?' active':'')+(coded.has(e.path)?' coded':'');
    const action=e.type==='dir'?`openExplorerPath('${esc(e.path)}')`:`openFile('${esc(e.path)}')`;
    rows.push(`<div class="file-row${cls}" onclick="${action}"><span>${icon}</span><span class="file-name">${esc(e.name)}</span><span class="file-size">${e.type==='file'?fmtSize(e.size):''}</span></div>`);
  });
  list.innerHTML=rows.join('')||'<div class="muted" style="padding:10px">leer</div>';
}
async function refreshExplorer(force){
  const now=Date.now(); if(!force && now-lastExplorerFetch<2000)return; lastExplorerFetch=now;
  try{ const r=await agentFetch('/files/tree?scope='+encodeURIComponent(explorerScope)+'&path='+encodeURIComponent(explorerPath)); renderExplorer(await r.json(), window.allCodeActivity||window.lastCodeActivity||[]); }catch(e){}
}
function openExplorerPath(p){ explorerPath=p||'.'; refreshExplorer(true); }
function setExplorerScope(scope){
  explorerScope=scope||'main'; explorerPath='.'; selectedFilePath='';
  ['Main','Support','Hermes','Shared'].forEach(k=>{const el=document.getElementById('scope'+k); if(el)el.classList.toggle('active', explorerScope===k.toLowerCase());});
  const title=document.getElementById('fileTitle'); const content=document.getElementById('fileContent');
  if(title)title.textContent='Keine Datei ausgewaehlt'; if(content)content.textContent='Klicke links auf eine Datei.';
  refreshExplorer(true);
}
async function openFile(p){
  selectedFilePath=p; refreshExplorer(true);
  const title=document.getElementById('fileTitle'); const content=document.getElementById('fileContent');
  try{ const data=await (await agentFetch('/files/read?scope='+encodeURIComponent(explorerScope)+'&path='+encodeURIComponent(p))).json(); title.textContent=(data.scope?data.scope+': ':'')+(data.path||p); content.textContent=data.content||''; content.className='file-content'; }
  catch(e){ title.textContent=p; content.textContent='FEHLER: '+e; }
}

let lastVisionTs=-1;
let visionStreamStarted=false;
function updateVision(s){
  const ts=s.vision_ts||0;
  const img=document.getElementById('vision');
  const ph=document.getElementById('visionPlaceholder');
  const info=document.getElementById('visionInfo');
  if(!img || !ph || !info) return;
  if(ts>0 && ts!==lastVisionTs){
    lastVisionTs=ts;
    if((s.vision_mode||'').startsWith('live') && !visionStreamStarted){
      visionStreamStarted=true;
      img.src='/vision_stream?t='+Date.now();
    } else if(!visionStreamStarted) {
      img.src='/vision.jpg?t='+ts;          // Cache-Buster: nur bei neuem Bild laden
    }
    img.style.display='block';
    ph.style.display='none';
    const fps=s.vision_fps?(' - '+s.vision_fps+' FPS lokal'):'';
    const change=(s.vision_change!==undefined)?(' - Aenderung '+s.vision_change):'';
    info.textContent='Live-Sicht des Agenten'+fps+change+(s.vision_info?(' - '+s.vision_info):'');
  }
}

async function addGoal(){
  const g=document.getElementById('goal').value.trim(); if(!g)return;
  const target=document.getElementById('goalTarget')?.value||'both';
  await agentFetch('/goal',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({goal:g,target})});
  document.getElementById('goal').value='';
}
async function cmd(c){await agentFetch('/cmd/'+c,{method:'POST'})}
