    base = str(CONFIG.get("ollama_url", ""))
    openai_url = str(CONFIG.get("openai_compatible_url", CONFIG.get("openai_base_url", "")))
    cloud_url = str(CONFIG.get("ollama_cloud_url", "https://ollama.com"))
    local_url = str(CONFIG.get("ollama_local_url", "http://localhost:11434"))
    routing = dict(CONFIG.get("model_routing") or {})
    cloud_primary = openai_mode or base.startswith("https://") or bool(CONFIG.get("hybrid_cloud_coding"))
    local_enabled = bool(CONFIG.get("use_local_fast", False))
    fallback_enabled = bool(CONFIG.get("local_fallback_to_cloud", True))
    budget = {
        "enabled": bool(CONFIG.get("ollama_budget_mode", False)),
        "profile": CONFIG.get("ollama_budget_profile", "normal"),
        "num_ctx": CONFIG.get("ollama_num_ctx", ""),
        "num_predict": CONFIG.get("ollama_num_predict", ""),
        "json_num_predict": CONFIG.get("ollama_json_num_predict", ""),
        "local_num_predict": CONFIG.get("ollama_local_num_predict", ""),
        "cloud_num_predict": CONFIG.get("ollama_cloud_num_predict", ""),
        "max_prompt_chars": CONFIG.get("ollama_max_prompt_chars", ""),
        "max_message_chars": CONFIG.get("ollama_max_message_chars", ""),
        "keep_alive": CONFIG.get("ollama_keep_alive", ""),
    }
    ollama_ps = _run_text(["ollama", "ps"], timeout=4)
