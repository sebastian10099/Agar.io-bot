def _combined_storage_guard(main_state, support_state, hermes_state=None):
    support_state = support_state or {}
    hermes_state = hermes_state or {}
    disk = shutil.disk_usage(HERE)
    root = {
        "used_gb": round(disk.used / (1024 ** 3), 2),
        "free_gb": round(disk.free / (1024 ** 3), 2),
        "total_gb": round(disk.total / (1024 ** 3), 2),
        "use_percent": round((disk.used / disk.total) * 100, 1) if disk.total else 0,
    }
    main_guard = main_state.get("storage_guard") or {}
    support_guard = support_state.get("storage_guard") or {}
    hermes_guard = hermes_state.get("storage_guard") or {}
    ok = (bool(main_guard.get("ok", True)) and bool(support_guard.get("ok", True))
          and bool(hermes_guard.get("ok", True)) and root["free_gb"] >= float(CONFIG.get("storage_min_free_gb", 10)))
    violations = []
    for label, guard in (("Haupt", main_guard), ("Support", support_guard), ("Hermes", hermes_guard)):
        for item in guard.get("violations", []) or []:
            violations.append(f"{label}: {item}")
    if root["free_gb"] < float(CONFIG.get("storage_min_free_gb", 10)):
        violations.append("Server: freier Speicher unter Limit")
    return {"ok": ok, "root": root, "main": main_guard, "support": support_guard, "hermes": hermes_guard, "violations": violations}


