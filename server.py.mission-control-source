        "local_provider": CONFIG.get("local_ai_provider", ""),
        "preferred_local_engine": CONFIG.get("preferred_local_engine", ""),
        "main_model": main_state.get("model") or CONFIG.get("openai_compatible_model") or CONFIG.get("ollama_model", ""),
        "support_model": support_state.get("model") or CONFIG.get("support_ollama_model", ""),
        "hermes_model": hermes_state.get("model") or CONFIG.get("hermes_ollama_model", ""),
        "routing": {
            "main": routing.get("main_agent", CONFIG.get("openai_compatible_model", CONFIG.get("ollama_model", ""))),
            "strategist": routing.get("strategist", CONFIG.get("openai_compatible_planner_model", CONFIG.get("ollama_strategist_model", ""))),
