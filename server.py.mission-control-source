TEAM_RULES = """# TEAM_RULES

- Haupt-Agent setzt um und veraendert primaer den Haupt-Workspace.
- Support-Agent nutzt den Support-Workspace, prueft Risiken, recherchiert, testet und reviewed.
- Hermes-Agent nutzt den Hermes-Workspace, pflegt Roadmap, Anti-Wiederholung, Lernnotizen und Team-Zusammenfassungen.
- Alle Agenten schreiben wichtige Entscheidungen in das Team-Journal.
- Headless-VPS: keine GUI-/Display-Aktionen; Shell, Dateien, Web und Self-Coding bevorzugen.
- Keine gefaehrlichen Loesch- oder Systemaktionen ohne klaren Nutzen und sichere Begrenzung.
- Nach Code-Aenderungen: Syntax/Test/Ausfuehrung pruefen und Ergebnis sichtbar dokumentieren.
- Haupt- und Support-Agent duerfen nicht gleichzeitig dieselbe Datei bearbeiten.
- Hermes darf Haupt-/Support-Dateien nur nach ausdruecklichem Ziel editieren; sonst schreibt er Plaene in seinen Workspace.
- Speicherbudget: Workspace, Backups und Logs muessen unter den konfigurierten Limits bleiben.
- Wenn ein Speicherlimit ueberschritten ist, Autopilot pausieren/deaktivieren und erst Diagnose/Fix dokumentieren.
- Jede produktive Aenderung braucht ein Test-Gate: geschrieben -> Syntax/Run/Test -> Ergebnis dokumentiert.
- Wiederholte Fehlschlaege fuehren zu Review/Support statt blindem Wiederholen.
"""

def _ensure_team_rules():
    path = os.path.join(HERE, "TEAM_RULES.md")
    if not os.path.exists(path):
        try:
            with open(path, "w", encoding="utf-8") as f:
                f.write(TEAM_RULES)
        except Exception:
            pass
    else:
        try:
            with open(path, "r", encoding="utf-8") as f:
                current = f.read()
            missing = []
            for line in TEAM_RULES.splitlines():
                if line.startswith("- ") and line not in current:
                    missing.append(line)
            if missing:
                with open(path, "a", encoding="utf-8") as f:
                    f.write("\n# Ergaenzte harte Regeln\n" + "\n".join(missing) + "\n")
        except Exception:
            pass
    return path

_ensure_team_rules()

def _team_rule_lines():
    path = os.path.join(HERE, "TEAM_RULES.md")
    try:
        with open(path, "r", encoding="utf-8") as f:
            raw = f.read()
    except Exception:
        raw = TEAM_RULES
    rules = []
    for line in raw.splitlines():
        line = line.strip()
        if line.startswith("- "):
            rules.append(line[2:].strip())
    return rules

def _dashboard_auth_ok():
    if not CONFIG.get("dashboard_auth_enabled", False):
        return True
    auth = request.authorization
    if not auth:
        return False
    expected_user = str(CONFIG.get("dashboard_user", ""))
    expected_pass = str(CONFIG.get("dashboard_password", ""))
    return (secrets.compare_digest(auth.username or "", expected_user) and
            secrets.compare_digest(auth.password or "", expected_pass))


@app.before_request
def _require_dashboard_auth():
    if _dashboard_auth_ok():
        return None
    return Response(
        "Login required",
        401,
        {"WWW-Authenticate": 'Basic realm="Local Agent Dashboard"'},
    )

