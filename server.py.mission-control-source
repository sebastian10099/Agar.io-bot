def _resource_status_snapshot():
    cores = os.cpu_count() or 1
    try:
        load1, load5, load15 = os.getloadavg()
    except Exception:
        load1 = load5 = load15 = 0.0
    proc_rows = []
    ps_out = _run_text(["ps", "-eo", "pid,pcpu,pmem,comm,args", "--sort=-pcpu"], timeout=5)
    skip_names = {"ps", "head", "bash", "sh", "grep", "lspci", "command"}
    for line in ps_out.splitlines()[1:16]:
        parts = line.split(None, 4)
        if len(parts) >= 5:
            if parts[3] in skip_names:
                continue
            proc_rows.append({
                "pid": parts[0],
                "cpu_percent": parts[1],
                "mem_percent": parts[2],
                "name": parts[3],
                "cmd": parts[4][:140],
            })
            if len(proc_rows) >= 7:
                break
    agent_cpu = 0.0
    for row in proc_rows:
        if "server.py" in row.get("cmd", "") or row.get("name") == "python":
            try:
                agent_cpu += float(row.get("cpu_percent") or 0)
            except ValueError:
                pass
    gpu_tools = {
        "nvidia_smi": bool(_run_text(["bash", "-lc", "command -v nvidia-smi"], timeout=3)),
        "rocm_smi": bool(_run_text(["bash", "-lc", "command -v rocm-smi"], timeout=3)),
    }
    gpu_lines = _run_text(["bash", "-lc", "lspci 2>/dev/null | grep -Ei 'vga compatible|3d controller|display controller|nvidia|advanced micro devices|amd/ati' || true"], timeout=4)
    gpu_visible = bool(gpu_tools["nvidia_smi"] or gpu_tools["rocm_smi"] or gpu_lines.strip())
    max_process_percent = cores * 100
    return {
        "cpu_cores": cores,
        "max_process_percent": max_process_percent,
        "load": {"one": round(load1, 2), "five": round(load5, 2), "fifteen": round(load15, 2)},
        "top_processes": proc_rows,
        "agent_cpu_percent": round(agent_cpu, 1),
        "gpu_visible": gpu_visible,
        "gpu_tools": gpu_tools,
        "gpu_devices": gpu_lines.splitlines()[:5],
        "ollama_ps": _run_text(["ollama", "ps"], timeout=4).splitlines()[:8],
        "explanation": f"Linux zaehlt CPU pro Kern: 100% ist ein voll genutzter Kern. Dieser Server hat {cores} Kerne, deshalb kann ein Prozess theoretisch bis {max_process_percent}% anzeigen. Eine echte GPU ist auf diesem VPS nicht sichtbar.",
    }


def _github_status_snapshot():
    repo = os.path.join(HERE, "agent_workspace")
    status_path = os.path.join(HERE, "github_sync_status.json")
    data = {}
    try:
        with open(status_path, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception:
        data = {}
    if not os.path.isdir(os.path.join(repo, ".git")):
        return {"enabled": False, "message": "Kein Git-Workspace gefunden.", "repo": repo}
    branch = _run_text(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=repo, timeout=5)
    remote = _run_text(["git", "remote", "get-url", "origin"], cwd=repo, timeout=5)
    head = _run_text(["git", "rev-parse", "--short", "HEAD"], cwd=repo, timeout=5)
    subject = _run_text(["git", "log", "-1", "--pretty=%s"], cwd=repo, timeout=5)
    dirty_lines = [x for x in _run_text(["git", "status", "--short"], cwd=repo, timeout=5).splitlines() if x.strip()]
    ahead_behind = _run_text(["bash", "-lc", "git rev-list --left-right --count @{u}...HEAD 2>/dev/null || echo '0 0'"], cwd=repo, timeout=5)
    behind = ahead = 0
    parts = ahead_behind.split()
    if len(parts) >= 2:
        try:
            behind, ahead = int(parts[0]), int(parts[1])
        except ValueError:
            behind = ahead = 0
    recent = _run_text(["git", "log", "--pretty=%h%x09%ar%x09%s", "-5"], cwd=repo, timeout=5)
    recent_rows = []
    for line in recent.splitlines():
        cols = line.split("\t", 2)
        if len(cols) == 3:
            recent_rows.append({"hash": cols[0], "age": cols[1], "subject": cols[2]})
    if dirty_lines:
        meaning = f"{len(dirty_lines)} lokale Aenderung(en) warten auf den naechsten Auto-Sync."
        state = "changes_waiting"
    elif ahead:
        meaning = f"{ahead} Commit(s) sind lokal fertig und warten auf Push."
        state = "ahead"
    elif behind:
        meaning = f"GitHub ist {behind} Commit(s) voraus; Auto-Sync holt nur konfliktfrei per Fast-forward."
        state = "behind"
    else:
        meaning = "GitHub und Server sind auf demselben Stand."
        state = data.get("state") or "clean"
    return {
        "enabled": True,
        "repo": repo,
        "remote": remote,
        "branch": branch,
        "head": head,
        "commit_subject": subject,
        "dirty_files": len(dirty_lines),
        "dirty_preview": dirty_lines[:8],
        "ahead": ahead,
        "behind": behind,
        "last_sync": data,
        "recent_commits": recent_rows,
        "state": state,
        "meaning": meaning,
        "auto_sync": "alle 10 Minuten per cron + flock",
    }


def _read_first_heading_tasks(path, limit=6):
    tasks = []
    try:
        for line in open(path, encoding="utf-8").read().splitlines():
            stripped = line.strip()
            if stripped.startswith("- [ ]"):
                tasks.append(stripped[5:].strip())
            if len(tasks) >= limit:
                break
    except Exception:
        pass
    return tasks


def _read_markdown_headings(path, prefix="### ", limit=8):
    items = []
    try:
        for line in open(path, encoding="utf-8").read().splitlines():
            if line.startswith(prefix):
                items.append(line[len(prefix):].strip())
            if len(items) >= limit:
                break
    except Exception:
        pass
    return items


