@app.route("/vision_stream")
def vision_stream():
    """MJPEG-Stream fuer die Live-Vorschau im Dashboard."""
    fps = max(1, min(int(CONFIG.get("dashboard_vision_fps", 15)), 30))
    delay = 1.0 / fps

    def gen():
        last = None
        while True:
            data = brain.get_vision_jpeg() if brain else None
            if data and data != last:
                last = data
                yield (
                    b"--frame\r\n"
                    b"Content-Type: image/jpeg\r\n"
                    b"Cache-Control: no-store\r\n\r\n" + data + b"\r\n"
                )
            time.sleep(delay)

    return Response(gen(), mimetype="multipart/x-mixed-replace; boundary=frame")


def _workspace_root(scope="main"):
    if scope == "support":
        root = CONFIG.get("support_workspace_dir", "agent_workspace_support")
    elif scope == "hermes":
        root = CONFIG.get("hermes_workspace_dir", "agent_workspace_hermes")
    elif scope == "shared":
        root = CONFIG.get("_base_dir", HERE)
    else:
        root = CONFIG.get("workspace_dir", "agent_workspace")
    if not os.path.isabs(root):
        root = os.path.join(HERE, root)
    os.makedirs(root, exist_ok=True)
    return os.path.abspath(root)


def _safe_workspace_path(rel="", scope="main"):
    scope = scope if scope in {"main", "support", "hermes", "shared"} else "main"
    root = _workspace_root(scope)
    rel = str(rel or ".").replace("\\", "/").lstrip("/")
    target = os.path.abspath(os.path.join(root, rel))
    if os.path.commonpath([root, target]) != root:
        raise ValueError("Pfad ausserhalb des Workspace")
    return root, target


def _rel_workspace_path(path, scope="main"):
    root = _workspace_root(scope)
    rel = os.path.relpath(path, root).replace("\\", "/")
    return "." if rel == "." else rel


@app.route("/files/tree")
def files_tree():
    try:
        scope = request.args.get("scope", "main")
        root, target = _safe_workspace_path(request.args.get("path", "."), scope)
        if not os.path.isdir(target):
            target = os.path.dirname(target)
        entries = []
        for name in sorted(os.listdir(target), key=lambda x: (not os.path.isdir(os.path.join(target, x)), x.lower()))[:400]:
            if name in {".venv", "__pycache__"}:
                continue
            if scope == "shared" and name not in {
                "TEAM_RULES.md", "team_exchange.jsonl", "agent.log", "memory.json",
                "memory_support.json", "autonomy_state.json", "autonomy_state_support.json",
                "memory_hermes.json", "autonomy_state_hermes.json",
                "code_activity.jsonl", "code_activity_support.jsonl", "code_activity_hermes.jsonl", "config.json"
            }:
                continue
            full = os.path.join(target, name)
            st = os.stat(full)
            typ = "dir" if os.path.isdir(full) else "file"
            entries.append({"name": name, "path": _rel_workspace_path(full, scope), "type": typ, "size": st.st_size, "mtime": int(st.st_mtime)})
        cwd = _rel_workspace_path(target, scope)
        parent = None if os.path.abspath(target) == os.path.abspath(root) else _rel_workspace_path(os.path.dirname(target), scope)
        return jsonify({"ok": True, "scope": scope, "root": root, "cwd": cwd, "parent": parent, "entries": entries})
    except Exception as e:
        return jsonify({"ok": False, "error": str(e), "entries": []}), 400


@app.route("/files/read")
def files_read():
    try:
        scope = request.args.get("scope", "main")
        _root, target = _safe_workspace_path(request.args.get("path", "."), scope)
        if not os.path.isfile(target):
            return jsonify({"ok": False, "error": "Keine Datei"}), 400
        size = os.path.getsize(target)
        with open(target, "rb") as f:
            raw = f.read(200000)
        content = raw.decode("utf-8", errors="replace")
        if size > len(raw):
            content += f"\n\n--- gekuerzt: {size-len(raw)} weitere Bytes ---"
        return jsonify({"ok": True, "scope": scope, "path": _rel_workspace_path(target, scope), "size": size, "content": content})
    except Exception as e:
        return jsonify({"ok": False, "error": str(e)}), 400



