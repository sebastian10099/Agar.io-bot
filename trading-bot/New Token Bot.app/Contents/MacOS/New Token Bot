#!/bin/bash
# "New Token Bot" – Doppelklick-Start.
#
# Startet den Bot im Hintergrund (Paper-Modus, echter Markt) und oeffnet die
# Steuerseite im Browser. Laeuft er schon, wird nur die Seite geoeffnet.
# Beenden: Knopf "Beenden" oben rechts auf der Steuerseite.
# Log: ~/Library/Application Support/NewTokenBot/bot.log
#
# Der Projektordner steht in Contents/Resources/project.path (schreibt
# install-app.sh); ohne die Datei gilt der Ordner, in dem das Bundle liegt.
set -u
BUNDLE="$(cd "$(dirname "$0")/../.." && pwd)"
if [ -f "$BUNDLE/Contents/Resources/project.path" ]; then
  PROJECT="$(head -n 1 "$BUNDLE/Contents/Resources/project.path")"
else
  PROJECT="$(cd "$BUNDLE/.." && pwd)"
fi
FIRST_PORT="${NEW_TOKEN_BOT_PORT:-8765}"
DATA="$HOME/Library/Application Support/NewTokenBot"
LOG="$DATA/bot.log"
mkdir -p "$DATA"

say_error() {
  /usr/bin/osascript -e "display dialog \"$1\" with title \"New Token Bot\" buttons {\"OK\"} default button 1 with icon stop" >/dev/null 2>&1
}

# Only OUR bot counts as running: /api/state must carry the marker. Another
# program on the same port (Local Studio uses 8765 too) is skipped, and the
# bot starts on the next free port instead.
ours() { /usr/bin/curl -s -m 2 "http://127.0.0.1:$1/api/state" 2>/dev/null | /usr/bin/grep -q '"app": "new-token-bot"'; }
free_port() {
  /usr/bin/curl -s -m 2 -o /dev/null "http://127.0.0.1:$1/" 2>/dev/null
  [ $? -eq 7 ]      # 7 = connection refused = nobody listens
}

PORT=""
for p in $(seq "$FIRST_PORT" $((FIRST_PORT + 9))); do
  if ours "$p"; then /usr/bin/open "http://127.0.0.1:$p/"; exit 0; fi
done
for p in $(seq "$FIRST_PORT" $((FIRST_PORT + 9))); do
  if free_port "$p"; then PORT="$p"; break; fi
done
if [ -z "$PORT" ]; then
  say_error "Kein freier Port zwischen $FIRST_PORT und $((FIRST_PORT + 9)). Andere Programme beenden und erneut versuchen."
  exit 1
fi
URL="http://127.0.0.1:$PORT/"

if [ ! -f "$PROJECT/launch.sh" ]; then
  say_error "Projektordner nicht gefunden: $PROJECT. Bitte install-app.sh im Ordner trading-bot erneut ausfuehren."
  exit 1
fi

cd "$PROJECT" || exit 1
: > "$LOG"
export PATH="$HOME/NewTokenBot/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"   # Finder-Start hat einen kurzen PATH; ant liegt hier
# NEW_TOKEN_BOT_ARGS="--demo" startet den Demo-Markt statt des echten
# shellcheck disable=SC2086
nohup /bin/bash ./launch.sh --no-open --port "$PORT" ${NEW_TOKEN_BOT_ARGS:-} >> "$LOG" 2>&1 < /dev/null &

for _ in $(seq 1 40); do
  sleep 0.5
  ours "$PORT" && { /usr/bin/open "$URL"; exit 0; }
  if ! kill -0 $! 2>/dev/null; then break; fi
done

TAIL="$(tail -n 6 "$LOG" | tr '"' "'" | tr '\\' '/')"
say_error "Der Bot ist nicht gestartet. Letzte Zeilen aus dem Log: ${TAIL}  (Log: $LOG)"
exit 1
