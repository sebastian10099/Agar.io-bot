#!/bin/bash
# App-Bundle-Starter: oeffnet ein Terminal-Fenster mit dem Bot, damit Log und
# Ctrl+C sichtbar bleiben. Das Bundle liegt im Projektordner.
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
/usr/bin/osascript <<OSA
tell application "Terminal"
  activate
  do script "cd \"$APP_DIR\" && bash ./launch.sh"
end tell
OSA
